# PostgreSQL connection string (SSL recommended in production)
# Example: postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tima_payments?schema=public"

# Session signing (generate a long random string)
SESSION_SECRET="replace-with-a-long-random-secret"

# PSP for **catalog checkout** and **invoice** “Pay with hosted checkout” (defaults to AIRWALLEX).
# AIRWALLEX | ADYEN | WORLDPAY | CYBERSOURCE | NUVEI
# ORDER_CHECKOUT_GATEWAY="AIRWALLEX"

# App URL for return/cancel links in hosted checkout
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Airwallex (optional — card data never touches this app; Hosted Payment Page collects cards at Airwallex)
# From Airwallex web app → Developer / API keys: Client ID + API key (secret). Not webhook signing secret.
# AIRWALLEX_CLIENT_ID=
# AIRWALLEX_API_KEY=
# Webhook signing secret from Airwallex web app → Settings → Developer → Webhooks (per notification URL).
# AIRWALLEX_WEBHOOK_SECRET=
# API host: production https://api.airwallex.com or demo https://api-demo.airwallex.com
# AIRWALLEX_API_BASE="https://api-demo.airwallex.com"
# Match Airwallex.js env to demo vs prod (defaults from AIRWALLEX_API_BASE if unset)
# NEXT_PUBLIC_AIRWALLEX_ENV="demo"
# ISO country for Hosted Payment Page (payment methods / compliance)
# AIRWALLEX_CHECKOUT_COUNTRY_CODE="US"

# Adyen
# ADYEN_API_KEY=
# ADYEN_MERCHANT_ACCOUNT=
# ADYEN_HMAC_KEY=

# Worldpay
# WORLDPAY_USERNAME=
# WORLDPAY_PASSWORD=
# WORLDPAY_WEBHOOK_SECRET=
# Worldpay webhook Basic Auth credentials (separate from API credentials; used for native webhook verification)
# WORLDPAY_WEBHOOK_USERNAME=
# WORLDPAY_WEBHOOK_PASSWORD=

# Cybersource
# CYBERSOURCE_MERCHANT_ID=
# CYBERSOURCE_KEY_ID=
# CYBERSOURCE_SECRET_KEY=
# CYBERSOURCE_WEBHOOK_SECRET=

# Nuvei (optional legacy adapter)
# NUVEI_MERCHANT_ID=
# NUVEI_MERCHANT_SITE_ID=
# NUVEI_SECRET_KEY=
# NUVEI_WEBHOOK_SECRET=

# Webhook signature (non-Airwallex PSPs / local curl)
# When a provider webhook secret (or ADYEN_HMAC_KEY) is set, requests must send:
#   X-Webhook-Signature: sha256=<hex>
# where <hex> is HMAC-SHA256(secret, raw UTF-8 body). Airwallex uses native x-timestamp + x-signature instead (see verify-webhook-hmac.ts).
